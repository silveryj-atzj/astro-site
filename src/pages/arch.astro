---
import ArchDiagram from '../components/ArchDiagram';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>服务架构图 · silveryj</title>
    <meta name="description" content="家庭服务架构图：Cloudflare / Tailscale / Proxmox LXC / AI 组件，可拖拽、网格吸附、自动保存。" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <ArchDiagram client:only="react" />
    <a class="back" href="/">← 返回博客</a>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0a0d11;
    --card: #151b23;
    --line: #26313f;
    --fg: #e8eef6;
    --muted: #8b98a8;
  }
  * { box-sizing: border-box; }
  html, body, #root { height: 100%; }
  html { background: var(--bg); }
  body {
    margin: 0;
    height: 100vh;
    overflow: hidden;
    background: radial-gradient(1400px 700px at 8% -8%, #101a26 0%, transparent 60%), var(--bg);
    color: var(--fg);
    font-family: system-ui, -apple-system, 'Segoe UI', 'Noto Sans SC', 'Microsoft YaHei', sans-serif;
  }
  .back {
    position: fixed; right: 18px; bottom: 14px; z-index: 40;
    font-size: 12px; color: var(--muted); text-decoration: none;
    background: rgba(15, 20, 26, .9); border: 1px solid var(--line);
    padding: 5px 12px; border-radius: 999px;
  }
  .back:hover { color: #cfe4ff; border-color: #3b4d65; }

  /* ---------- 布局骨架 ---------- */
  .af-root { display: flex; flex-direction: column; height: 100vh; }
  .af-toolbar {
    height: 52px; flex: 0 0 52px; display: flex; align-items: center; gap: 10px; padding: 0 16px;
    background: rgba(12, 17, 23, .9); backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line); z-index: 10;
  }
  .af-toolbar strong { font-size: 14px; }
  .af-tag { font-size: 11px; color: var(--muted); border: 1px solid var(--line); padding: 2px 9px; border-radius: 999px; }
  .af-spacer { flex: 1; }
  .af-toolbar button {
    background: var(--card); color: var(--fg); border: 1px solid var(--line);
    border-radius: 8px; padding: 5px 10px; font-size: 12px; cursor: pointer; font-family: inherit;
  }
  .af-toolbar button:hover { border-color: #3b4d65; background: #18212b; }
  .af-saved { font-size: 11px; color: #22c55e; width: 62px; }
  .af-canvas { position: relative; flex: 1 1 auto; min-height: 0; }

  /* ---------- 节点卡片 ---------- */
  .af-card {
    position: relative; width: 100%; height: 100%; overflow: hidden;
    background: var(--card); border: 1px solid #2b3849; border-radius: 11px;
    padding: 10px 13px; display: flex; flex-direction: column; justify-content: center; gap: 3px;
    box-shadow: 0 8px 22px rgba(0, 0, 0, .3);
  }
  .af-card:hover { border-color: #4f6b8c; }
  .af-bar { position: absolute; left: 0; top: 0; bottom: 0; width: 3px; border-radius: 11px 0 0 11px; }
  .af-title { font-size: 13px; font-weight: 600; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .af-sub { font-size: 11px; color: var(--muted); line-height: 1.25; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .af-k-cloud .af-bar { background: #f59e0b; }
  .af-k-compute .af-bar { background: #3b82f6; }
  .af-k-ai .af-bar { background: #22c55e; }
  .af-k-data .af-bar { background: #a855f7; }
  .af-k-net .af-bar { background: #06b6d4; }
  .af-k-ci .af-bar { background: #14b8a6; }
  .af-k-pub .af-bar { background: #ef4444; }
  .af-k-deploy .af-bar { background: #8b5cf6; }
  .af-h { width: 6px; height: 6px; background: #3a5474; border: 0; opacity: 0; }

  /* ---------- 分组节点 ---------- */
  .react-flow__node-group {
    background: rgba(255, 255, 255, .015);
    border: 1px dashed #2b3a4d;
    border-radius: 16px;
    color: var(--muted);
    font-size: 12px;
  }
  .react-flow__node-group > .react-flow__handle { display: none; }

  /* ---------- 控件 / minimap ---------- */
  .react-flow__controls { box-shadow: none; }
  .react-flow__controls-button {
    background: #111a24; border-bottom: 1px solid var(--line); color: #cfe4ff;
  }
  .react-flow__controls-button:hover { background: #18242f; }
  .react-flow__minimap { border-radius: 10px; overflow: hidden; }
  .react-flow__panel { color: var(--muted); }

  /* ---------- 详情面板 ---------- */
  .af-detail {
    position: absolute; right: 16px; top: 16px; width: 340px; max-height: calc(100% - 90px);
    overflow: auto; z-index: 20; padding: 16px 18px; font-size: 13px; line-height: 1.65;
    background: rgba(15, 20, 26, .98); border: 1px solid var(--line); border-radius: 14px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, .55); backdrop-filter: blur(12px);
  }
  .af-detail h3 { margin: 0 0 4px; font-size: 15px; }
  .af-detail-sub { color: var(--muted); font-size: 12px; margin-bottom: 8px; }
  .af-detail p { color: #c7d3e1; margin: 0; }
  .af-close {
    position: absolute; right: 10px; top: 6px; background: none; border: 0;
    color: var(--muted); font-size: 19px; cursor: pointer;
  }

  /* ---------- 图例 ---------- */
  .af-legend {
    position: absolute; left: 16px; bottom: 14px; z-index: 20;
    display: flex; flex-wrap: wrap; gap: 8px 16px; max-width: 70%;
    font-size: 11.5px; color: var(--muted);
    background: rgba(12, 17, 23, .86); border: 1px solid var(--line);
    border-radius: 10px; padding: 9px 13px; backdrop-filter: blur(8px);
  }
  .af-legend span { display: inline-flex; align-items: center; gap: 6px; }
  .af-dot { display: inline-block; width: 9px; height: 9px; border-radius: 3px; }
  .af-line { display: inline-block; width: 22px; border-top: 2px solid; }
  .af-dash { border-top-style: dashed; }
</style>
