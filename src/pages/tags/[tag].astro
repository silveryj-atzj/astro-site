---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tagMap = new Map<string, typeof posts>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      tagMap.set(tag, [...(tagMap.get(tag) ?? []), post]);
    }
  }
  return [...tagMap.entries()].map(([tag, items]) => ({
    params: { tag },
    props: {
      tag,
      posts: items.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<Base title={`标签：${tag}`} description={`标签 ${tag} 下的文章`}>
  <h1>#{tag}</h1>
  <p class="sub">{posts.length} 篇文章 · <a href="/tags/">全部标签</a></p>

  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        <time>{post.data.date.toISOString().slice(0, 10)}</time>
        {post.data.description && <p>{post.data.description}</p>}
      </li>
    ))}
  </ul>
</Base>
