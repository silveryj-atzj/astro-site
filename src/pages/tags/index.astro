---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const tagMap = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagMap.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Base title="标签" description="按标签浏览文章">
  <h1>标签</h1>
  <p class="sub">共 {tags.length} 个标签 · {posts.length} 篇文章</p>

  <ul class="tag-cloud">
    {tags.map(([tag, count]) => (
      <li>
        <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag} <span class="count">{count}</span></a>
      </li>
    ))}
  </ul>
</Base>
