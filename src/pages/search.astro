---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const index = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags,
  url: `/blog/${post.id}/`,
  date: post.data.date.toISOString().slice(0, 10),
}));
---

<Base title="搜索" description="搜索文章">
  <h1>搜索</h1>
  <p class="sub">输入关键词，实时筛选 {posts.length} 篇文章</p>

  <input
    id="search-input"
    class="search-input"
    type="search"
    placeholder="搜索标题 / 摘要 / 标签…"
    autocomplete="off"
    autofocus
  />
  <p id="search-status" class="sub"></p>
  <ul id="search-results" class="post-list"></ul>

  <script id="search-data" type="application/json" set:html={JSON.stringify(index)} />

  <script>
    import Fuse from 'fuse.js';

    type Item = { title: string; description: string; tags: string[]; url: string; date: string };

    const dataEl = document.getElementById('search-data');
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const list = document.getElementById('search-results');
    const status = document.getElementById('search-status');

    if (dataEl && input && list && status) {
      const data: Item[] = JSON.parse(dataEl.textContent || '[]');
      const fuse = new Fuse(data, {
        keys: [
          { name: 'title', weight: 0.6 },
          { name: 'description', weight: 0.25 },
          { name: 'tags', weight: 0.15 },
        ],
        threshold: 0.4,
        ignoreLocation: true,
      });

      const render = (items: Item[]) => {
        list.innerHTML = items
          .map(
            (it) => `<li><a href="${it.url}">${it.title}</a><time>${it.date}</time>${
              it.description ? `<p>${it.description}</p>` : ''
            }</li>`
          )
          .join('');
      };

      input.addEventListener('input', () => {
        const q = input.value.trim();
        if (!q) {
          list.innerHTML = '';
          status.textContent = '';
          return;
        }
        const res = fuse.search(q).map((r) => r.item);
        status.textContent = `找到 ${res.length} 篇`;
        render(res);
      });

      render(data);
      status.textContent = `共 ${data.length} 篇`;
    }
  </script>
</Base>
