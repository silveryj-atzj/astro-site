  .case:first-of-type { border-top: 0; padding-top: 0; }
  .case h2 { font-size: 23px; margin: 0 0 4px; }
  .case h3 { font-size: 15px; margin: 22px 0 8px; color: #c3d0de; }
  .case .meta { color: var(--muted); font-size: 12px; letter-spacing: .05em; text-transform: uppercase; margin: 0 0 14px; }
  .case p { line-height: 1.8; }
  .case ul { line-height: 1.85; padding-left: 20px; }
  .case code { background: #121a23; border: 1px solid var(--line); border-radius: 5px; padding: 1px 5px; font-size: 12.5px; }
  .case .stack { margin-top: 14px; font-size: 12px; color: var(--muted); }
  .back { margin-top: 40px; }
</style>
