---
type Lang = 'zh' | 'en';
const {
  title = 'silveryj',
  description = '个人站 · 自托管服务 · 写点东西',
  lang = 'zh' as Lang,
} = Astro.props as { title?: string; description?: string; lang?: Lang };

const year = new Date().getFullYear();
const path = Astro.url.pathname;

const labels = {
  zh: { home: '首页', projects: '项目', blog: '博客', about: '关于', forum: '论坛', rss: 'RSS' },
  en: { home: 'Home', projects: 'Projects', blog: 'Blog', about: 'About', forum: 'Forum', rss: 'RSS' },
}[lang];

/* 中英互跳：只对已翻译的页面做映射，其他页面回落到该语言首页 */
function toEn(p: string) {
  if (p === '/') return '/en/';
  if (p.startsWith('/projects')) return '/en/projects/';
  if (p.startsWith('/about')) return '/en/about/';
  return '/en/';
}
function toZh(p: string) {
  if (p === '/en/' || p === '/en') return '/';
  if (p.startsWith('/en/projects')) return '/projects/';
  if (p.startsWith('/en/about')) return '/about/';
  return '/';
}

const isEn = lang === 'en';
const switchHref = isEn ? toZh(path) : toEn(path);
const switchLabel = isEn ? '中文' : 'EN';
const homeHref = isEn ? '/en/' : '/';
const projectsHref = isEn ? '/en/projects/' : '/projects/';
const aboutHref = isEn ? '/en/about/' : '/about/';
const otherHref = isEn ? '/en/' : '/';
const htmlLang = isEn ? 'en' : 'zh-CN';
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'silveryj' ? title : `${title} · silveryj`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="silveryj blog" href="/rss.xml" />
    <link rel="alternate" hreflang="zh-CN" href={new URL(path.startsWith('/en') ? toZh(path) : path, Astro.site).toString()} />
    <link rel="alternate" hreflang="en" href={new URL(path.startsWith('/en') ? path : toEn(path), Astro.site).toString()} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={homeHref}>silveryj</a>
      <nav>
        <a href={homeHref}>{labels.home}</a>
        <a href={projectsHref}>{labels.projects}</a>
        <a href={isEn ? '/blog/' : '/blog/'}>{labels.blog}</a>
        <a href={aboutHref}>{labels.about}</a>
        <a href="https://silveryj-atzj.me" target="_blank" rel="noopener">{labels.forum}</a>
        <a class="lang-switch" href={switchHref} aria-label="Switch language">{switchLabel}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>© {year} silveryj-atzj.me · Astro · <a href="/rss.xml">{labels.rss}</a></p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0b0d10;
    --card: #14181d;
    --line: #232a32;
    --fg: #e6edf3;
    --muted: #8b98a5;
    --accent: #6ea8fe;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: radial-gradient(1200px 600px at 50% -10%, #16202b 0%, var(--bg) 60%);
    color: var(--fg);
    font: 16px/1.7 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', 'Noto Sans SC', sans-serif;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  .site-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 24px; border-bottom: 1px solid var(--line);
    max-width: 980px; width: 100%; margin: 0 auto;
  }
  .brand { font-weight: 700; color: var(--fg); text-decoration: none; letter-spacing: .02em; }
  .site-header nav { display: flex; gap: 18px; align-items: center; }
  .site-header nav a { color: var(--muted); text-decoration: none; font-size: 14px; }
  .site-header nav a:hover { color: var(--fg); }
  .site-header nav a.lang-switch {
    color: var(--fg); border: 1px solid var(--line); border-radius: 999px;
    padding: 2px 10px; font-size: 12.5px;
  }
  .site-header nav a.lang-switch:hover { border-color: #3f5a78; }
  main { width: 100%; max-width: 980px; margin: 0 auto; padding: 56px 24px 40px; flex: 1; }
  h1 { font-size: clamp(32px, 5vw, 48px); margin: 0 0 8px; letter-spacing: -0.02em; }
  h2 { margin-top: 40px; }
  p.sub { margin: 0 0 36px; color: var(--muted); }
  a { color: var(--accent); }
  .post-list { list-style: none; padding: 0; margin: 32px 0 0; display: grid; gap: 14px; }
  .post-list li { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; }
  .post-list a { font-weight: 600; font-size: 18px; text-decoration: none; }
  .post-list time { display: block; color: var(--muted); font-size: 13px; margin-top: 4px; }
  .post-list p { margin: 8px 0 0; color: var(--muted); font-size: 14px; }
  .prose { max-width: 720px; }
  .prose h2 { font-size: 24px; margin-top: 36px; }
  .prose h3 { font-size: 19px; }
  .prose code { background: #1b2229; padding: 2px 6px; border-radius: 5px; font-size: 90%; }
  .prose pre { background: #11161b; border: 1px solid var(--line); padding: 16px; border-radius: 10px; overflow-x: auto; }
  .prose pre code { background: none; padding: 0; }
  .prose blockquote { border-left: 3px solid var(--accent); margin: 20px 0; padding: 4px 16px; color: var(--muted); }
  .prose img { max-width: 100%; border-radius: 10px; }
  footer { border-top: 1px solid var(--line); padding: 18px 24px; color: var(--muted); font-size: 13px; text-align: center; }
  footer a { color: var(--muted); }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  .grid a { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; background: var(--card); border: 1px solid var(--line); border-radius: 12px; text-decoration: none; color: inherit; transition: transform .15s ease, border-color .15s ease; }
  .grid a:hover { transform: translateY(-2px); border-color: #3a4b5f; }
  .grid strong { font-weight: 600; }
  .grid span { color: var(--muted); font-size: 14px; }

  /* 标签云 / 标签 chips */
  .tag-cloud { list-style: none; margin: 28px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .tag-cloud a { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; background: var(--card); border: 1px solid var(--line); border-radius: 999px; text-decoration: none; color: var(--fg); font-size: 14px; transition: border-color .15s ease, transform .15s ease; }
  .tag-cloud a:hover { border-color: #3a4b5f; transform: translateY(-1px); }
  .tag-cloud .count { color: var(--muted); font-size: 12px; }
  .chip { display: inline-block; padding: 2px 9px; margin: 0 6px 6px 0; background: #161d24; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); font-size: 12px; text-decoration: none; }
  .chip:hover { color: var(--fg); border-color: #3a4b5f; }

  /* 搜索框 */
  .search-input { width: 100%; margin: 20px 0 12px; padding: 12px 16px; background: var(--card); border: 1px solid var(--line); border-radius: 10px; color: var(--fg); font-size: 15px; outline: none; }
  .search-input:focus { border-color: var(--accent); }
  .meta { color: var(--muted); font-size: 13px; margin: 4px 0 24px; }
  .pager { display: flex; justify-content: space-between; gap: 16px; margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--line); font-size: 14px; }
  .pager a { text-decoration: none; }
  .pager .next { text-align: right; }
</style>
